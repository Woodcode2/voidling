
# QA probe output
qa-out/

# SCRATCH BUILDS. An agent comparing two renders builds a second dist beside
# the real one; each is ~41 MB and none of them belong in history. Two got
# committed by a `git add -A` earlier in this project's life, once as roughly
# 400 files. One pattern instead of naming them one at a time as they appear.
dist-*/

# Gate reports — regenerated on every run, never worth a diff
qa/out/gate/

# Probe screenshots and bake dumps — evidence for one session, regenerated on demand
qa/out/bake/
qa/out/shippedlook/maple_afterspin.png
qa/out/shippedlook/maple_drifts.png
qa/out/shippedlook/maple_faces.png
qa/out/shippedlook/maple_leaves.png

# The studio's evidence pack — rebuilt on demand by qa/lookbook.mjs, and large.
# The character sheet in particular is four full-resolution frames per run.
# Evidence for a decision belongs in a commit message or a ledger entry; the
# pixels themselves are reproducible, so they do not belong in history.
qa/out/person/
qa/out/shippedlook/*_look.png
qa/out/shippedlook/maple_trees.png

# Every shippedlook frame is a probe artefact. The two the ledger cites are
# already tracked; new ones are evidence for a moment, not for history.
qa/out/shippedlook/maple_tone.png
qa/out/lookbook.json

# shoot:store moves the previous set here rather than deleting it
store/.previous/
